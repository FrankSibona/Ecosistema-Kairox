{
  "io_map": {
    "inputs": {
      "demand":                {"gpio": 27,   "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "pressure_ok":           {"gpio": 26,   "mode": "pullup",   "invert": 0, "default_value": 1, "debounce_ms": 2000},
      "raw_water_available":   {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 1, "debounce_ms": 0},
      "softener_regenerating": {"gpio": 25,   "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "permeate_tank_low":     {"gpio": 33,   "mode": "pulldown", "invert": 0, "default_value": 0, "debounce_ms": 0},
      "final_tank_demand":     {"gpio": 32,   "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "phase_failure":         {"gpio": 23,   "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "dosing_ok":             {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "feed_tank_high":        {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "feed_tank_low":         {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "final_tank_high":       {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "final_tank_low":        {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "permeate_tank_demand":  {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "permeate_tank_high":    {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0},
      "well_low_level":        {"gpio": null, "mode": "pullup",   "invert": 0, "default_value": 0, "debounce_ms": 0}
    },
    "outputs": {
      "well_pump":          {"gpio": 4,    "invert": 0},
      "high_pressure_pump": {"gpio": 16,   "invert": 0},
      "transfer_pump":      {"gpio": 17,   "invert": 0},
      "flush_valve":        {"gpio": 18,   "invert": 0},
      "low_pressure_pump":  {"gpio": null, "invert": 0},
      "inlet_valve":        {"gpio": null, "invert": 0},
      "dosing_pump":        {"gpio": null, "invert": 0}
    }
  },
  "features": {
    "feature_well_pump": true,
    "feature_transfer_pump": true,
    "feature_softener_interlock": true
  },
  "rules": {
    "process_permits": {
      "ro": {"op": "AND", "terms": [
        {"signal": "softener_regenerating", "source": "input", "negate": true}
      ]}
    },
    "independent_outputs": {
      "well_pump": {"op": "OR", "terms": [
        {"signal": "ro_producing",          "source": "derived", "negate": false},
        {"signal": "softener_regenerating", "source": "input",   "negate": false}
      ]},
      "transfer_pump": {"op": "AND", "terms": [
        {"signal": "final_tank_demand", "source": "input", "negate": false},
        {"signal": "permeate_tank_low", "source": "input", "negate": false}
      ]}
    },
    "fault_rules": [
      {
        "condition": {"op": "AND", "terms": [{"signal": "phase_failure", "source": "input", "negate": false}]},
        "reason": "PHASE_FAILURE",
        "delay_sec": 1
      }
    ]
  }
}
