# =============================================================================
# KAIROX — Environment Variables Example
# =============================================================================
#
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env
#   2. Reemplazar todos los valores <PLACEHOLDER> con valores reales
#   3. NUNCA commitear el archivo .env al repositorio
#   4. El archivo .env debe estar en .gitignore
#
# SEGURIDAD:
#   - Este archivo (.env.example) es seguro para commitear (sin credenciales reales)
#   - El archivo .env contiene secretos reales y NUNCA debe estar en git
#   - En producción, usar un gestor de secretos (Vault, AWS SSM, etc.)
#
# USO EN DOCKER COMPOSE:
#   Agregar a cada servicio en docker-compose.yml:
#     env_file:
#       - .env
# =============================================================================


# =============================================================================
# POSTGRESQL
# =============================================================================

DB_HOST=ro-postgres
DB_NAME=iot_db
DB_USER=<DB_USERNAME>
DB_PASS=<DB_PASSWORD>

# Para el contenedor PostgreSQL (POSTGRES_* son usadas por la imagen oficial)
POSTGRES_USER=<DB_USERNAME>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=iot_db


# =============================================================================
# MQTT (Mosquitto)
# =============================================================================

MQTT_BROKER=ro-mosquitto
MQTT_PORT=1883
MQTT_USER=<MQTT_USERNAME>
MQTT_PASS=<MQTT_PASSWORD>


# =============================================================================
# FLASK / PANEL DE ADMIN
# =============================================================================

# Dejar vacío para deshabilitar autenticación (solo en desarrollo)
# En producción SIEMPRE configurar con credenciales fuertes
ADMIN_PANEL_USER=<ADMIN_PANEL_USERNAME>
ADMIN_PANEL_PASS=<ADMIN_PANEL_PASSWORD>


# =============================================================================
# TELEGRAM
# =============================================================================

# Obtener de @BotFather en Telegram
TELEGRAM_TOKEN=<TELEGRAM_BOT_TOKEN>

# Chat ID del canal/grupo de alertas globales (admin)
# Obtener enviando un mensaje al bot y consultando:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_CHAT=<TELEGRAM_CHAT_ID>


# =============================================================================
# SMTP (EMAIL)
# =============================================================================

# Dejar vacío para deshabilitar notificaciones por email
SMTP_HOST=<smtp.example.com>
SMTP_PORT=587
SMTP_USER=<alertas@example.com>
SMTP_PASS=<SMTP_PASSWORD>
SMTP_FROM=<alertas@example.com>

# Destinatarios globales de alertas (separados por coma)
SMTP_TO=<operador1@example.com,operador2@example.com>


# =============================================================================
# AI ENGINE
# =============================================================================

# Dejar vacío para deshabilitar el motor IA completamente
AI_ENDPOINT_URL=<https://your-ai-api.example.com/decide>

# Bearer token para el servicio IA (lectura de contexto + sugerencias)
AI_API_KEY=<AI_SERVICE_API_KEY>

# Bearer token para operadores humanos (cambios de modo AI Gate)
ADMIN_API_KEY=<ADMIN_API_KEY>

# Modo por defecto al iniciar: OBSERVE_ONLY | AUTO_EXECUTE | LOCKDOWN
AI_GATE_DEFAULT_MODE=OBSERVE_ONLY

# Frecuencia de polling IA (segundos, mínimo 10)
AI_POLL_INTERVAL_SEC=60

# Profundidad de la ventana de telemetría enviada a la IA (segundos)
AI_WINDOW_SECONDS=60

# Período entre muestras en la ventana (segundos)
AI_SAMPLE_PERIOD_SEC=1

# Máximo de muestras por payload
AI_WINDOW_MAX_SAMPLES=120

# Timeout para llamadas a la IA (segundos)
AI_TIMEOUT_SEC=10

# Cooldown entre comandos automáticos consecutivos (segundos)
AI_AUTO_COOLDOWN_SEC=300


# =============================================================================
# THRESHOLDS DE ALERTAS
# =============================================================================
# Estos valores sobreescriben los defaults de alert_config.py
# Solo incluir si se quieren valores distintos a los defaults

# TDS salida — activación y resolución (ppm)
THRESH_TDS_OUT_WARN=80.0
THRESH_TDS_OUT_RESOLVE=70.0

# Presión baja (bar, solo durante PRODUCING)
THRESH_LOW_PRESSURE=2.0
THRESH_LOW_PRESSURE_RESOLVE=2.5

# Presión alta — límite de seguridad (bar)
THRESH_HIGH_PRESSURE=9.0
THRESH_HIGH_PRESSURE_RESOLVE=8.5

# Caudal mínimo de permeado (L/min)
THRESH_MIN_FLOW=0.05

# Segundos sin caudal antes de NO_PERMEATE_FLOW
THRESH_NO_FLOW_SEC=30

# Eficiencia mínima (0-1)
THRESH_LOW_EFFICIENCY=0.85
THRESH_LOW_EFFICIENCY_RESOLVE=0.87

# Segundos sin telemetría antes de DEVICE_OFFLINE
THRESH_OFFLINE_SEC=90

# Intervalo de verificación offline (segundos)
THRESH_OFFLINE_CHECK_SEC=30

# Intervalo de re-notificación para alertas activas (segundos)
THRESH_REMINDER_SEC=3600


# =============================================================================
# GRAFANA
# =============================================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<GRAFANA_ADMIN_PASSWORD>
GF_USERS_ALLOW_SIGN_UP=false
